<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Un único ejecutable con todo dentro: .NET, el lector de memoria de Arena
    (vendor/HackF5.UnitySpy) y el texto de la licencia. Quien lo descarga no
    instala nada ni necesita ficheros al lado.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- `-windows` por las dos cosas que sólo existen en Windows y que este
         programa usa de serie: el registro (el arranque automático) y las
         llamadas a user32/gdi32 del aviso que se pinta sobre Arena. NO trae
         WinForms: eso se quitó a propósito, porque doblaba el tamaño del
         ejecutable (ver Superposicion.cs). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>

    <Nullable>enable</Nullable>
    <AssemblyName>MtgCornerArenaBridge</AssemblyName>
    <RootNamespace>MtgCornerArenaBridge</RootNamespace>

    <!--
      LA VERSIÓN, Y POR QUÉ IMPORTA.

      El release se publicaba SIEMPRE con la etiqueta "latest" y el mismo nombre
      de fichero, así que nada —ni el navegador, ni este programa— podía saber
      si el .exe de ahí fuera era el mismo que ya tenías: quien lo había
      descargado volvía a descargarlo por si acaso.

      Con esto, cada publicación deja además un release `v<Version>` con el
      fichero `MtgCornerArenaBridge-<Version>.exe`, y el programa compara su
      propia versión con la última al arrancar (ComprobarVersion, en
      Program.cs). La etiqueta `latest` se mantiene para que el botón de la web
      no cambie nunca.

      AL PUBLICAR UN CAMBIO, SUBIR ESTE NÚMERO. Si no, el release versionado se
      pisa a sí mismo con contenido distinto y la comparación miente.
    -->
    <Version>1.10.0</Version>

    <!-- Autocontenido: quien lo descarga no necesita instalar el .NET runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- El icono de la web, con seis tamaños (mtgcorner.ico). -->
    <ApplicationIcon>mtgcorner.ico</ApplicationIcon>

    <!-- Un único fichero y comprimido: baja de ~130 MB en dos programas a uno
         de unos 30 MB, ahora que el lector de memoria va dentro. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- El lector de memoria de Arena, del proyecto mtga-tracker-daemon
       (frcaton, GPLv3), copiado en vendor/. Por eso este programa es GPLv3. -->
  <!-- vendor/ ESTÁ DENTRO DE ESTA CARPETA, así que el SDK lo compilaría también
       aquí: los mismos tipos saldrían dos veces (una sin permitir código no
       seguro, que es lo que la librería necesita para leer memoria en Linux) y
       la compilación falla. Lo compila SÓLO su propio proyecto, referenciado
       más abajo. -->
  <ItemGroup>
    <Compile Remove="vendor/**" />
    <EmbeddedResource Remove="vendor/**" />
    <None Remove="vendor/**" />
  </ItemGroup>

  <!-- La GPLv3 va DENTRO del ejecutable: se distribuye como un fichero suelto,
       así que la opción de licencia del programa la deja al lado cuando alguien la quiera. -->
  <ItemGroup>
    <EmbeddedResource Include="LICENSE" LogicalName="LICENCIA-GPLv3.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor/HackF5.UnitySpy/HackF5.UnitySpy.csproj" />
  </ItemGroup>

</Project>
