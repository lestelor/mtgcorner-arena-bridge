+        // ── Parche de MTG Corner: ayudantes de /diagnostico ──
+
+        private static string CamposDe(ITypeDefinition tipo)
+        {
+            if (tipo == null) return "<unknown type>";
+            try
+            {
+                var nombres = tipo.Fields.Where(f => f != null).Select(f => f.Name).Take(80).ToList();
+                return tipo.FullName + " { " + string.Join(", ", nombres) + " }";
+            }
+            catch (Exception ex)
+            {
+                return tipo.FullName + " { fields unreadable: " + ex.GetType().Name + ": " + ex.Message + " }";
+            }
+        }
+
+        private static object Paso(List<string> informe, string nombre, Func<object> leer)
+        {
+            try
+            {
+                object valor = leer();
+                if (valor == null)
+                {
+                    informe.Add(nombre + " = null");
+                    return null;
+                }
+                if (valor is IManagedObjectInstance objeto)
+                {
+                    informe.Add(nombre + " -> " + CamposDe(objeto.TypeDefinition));
+                }
+                else
+                {
+                    informe.Add(nombre + " -> " + valor.GetType().Name);
+                }
+                return valor;
+            }
+            catch (Exception ex)
+            {
+                informe.Add(nombre + " FAILED: " + ex.GetType().Name + ": " + ex.Message);
+                return null;
+            }
+        }
+
+        private static object Siguiente(List<string> informe, object actual, string campo)
+        {
+            if (actual == null) return null;
+            if (!(actual is IManagedObjectInstance objeto))
+            {
+                informe.Add("cannot read " + campo + " from " + actual.GetType().Name);
+                return null;
+            }
+            return Paso(informe, campo, () => objeto.GetValue<object>(campo));
+        }
